# --- Required: the app will not start without these ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key

# --- Agent mode (on by default since v1.5) ---
# One model and four read-only tools answer each question. The default model is
# Claude Sonnet 5.5, which needs this key. Left blank, the app logs a warning and
# answers with the classic pipeline instead. See README: "Agent mode".
ANTHROPIC_API_KEY=
# AGENT_MODE=0                              # off: the classic pipeline (router, SQL loop, answer rules)
# AGENT_MODEL=anthropic:claude-sonnet-5-5   # or gemini:<id> / openrouter:<id> (needs OPENROUTER_API_KEY)
# AGENT_MAX_STEPS=16
# AGENT_TIME_BUDGET_S=180

# --- Optional: LangSmith tracing ---
# Read automatically by the LangSmith SDK. You can also set these in the
# admin Settings UI instead, which stores them in the database.
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=rag-masterclass
LANGSMITH_TRACING=true

# --- Optional: test suite only ---
# Password for the seeded admin test user. Used by scripts/test_helpers.py,
# scripts/seed_admin_user.py, and scripts/test_two_scope_rls.py.
# Not needed to run the app — only to run the backend tests and evals.
TEST_USER_ADMIN_PASSWORD=your-admin-test-password

# --- NOT set here ---
# Tavily (web search) API key is configured in the admin Settings UI and
# stored in the database, not in this file.
# COHERE_API_KEY is present in this project's .env as a local override;
# normally configured in the admin Settings UI instead.
COHERE_API_KEY=
